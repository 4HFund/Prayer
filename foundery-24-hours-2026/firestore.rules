rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
   function admin() { return request.auth != null && request.auth.token.prayerAdmin == true; }
   match /prayerSubmissions/{id} {
     allow create: if request.auth != null
       && request.resource.data.keys().hasOnly(['name','body','visibility','status','createdAt','submittedBy'])
       && request.resource.data.name is string && request.resource.data.name.size() <= 80
       && request.resource.data.body is string && request.resource.data.body.size() >= 5 && request.resource.data.body.size() <= 2000
       && request.resource.data.visibility in ['public','anonymous','private']
       && request.resource.data.status == 'pending'
       && request.resource.data.submittedBy == request.auth.uid
       && request.resource.data.createdAt == request.time;
     allow read, update, delete: if admin();
   }
   match /approvedPrayers/{id} {
     allow read: if true;
     allow create, update, delete: if admin();
   }
   match /{document=**} { allow read, write: if false; }
 }
}
